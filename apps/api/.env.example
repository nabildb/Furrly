PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase → botón "Connect" → ORMs → Prisma. Si la contraseña tiene caracteres
# especiales (# / * @ ?...) hay que codificarlos en la URL (p. ej. # → %23).
# DATABASE_URL: pooler en modo transaction (puerto 6543), lo usa la app
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL: conexión directa / session (puerto 5432), la usan las migraciones
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co

# Producción detrás de un proxy (Render): 1
TRUST_PROXY=0
